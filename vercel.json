{
  "crons": [
    {
      "path": "/api/whatsapp/execute-automations",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/webhooks/meta-leads",
      "destination": "/api/webhooks/meta-leads.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
